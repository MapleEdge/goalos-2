{
  "name": "goalos-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@goalos/web",
    "dev:desktop": "turbo run dev --filter=@goalos/desktop",
    "build": "turbo run build",
    "build:all": "turbo run build",
    "build:web": "turbo run build --filter=@goalos/web",
    "build:desktop": "turbo run build --filter=@goalos/desktop",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "knip": "knip",
    "knip:production": "knip --production",
    "release": "release-it",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "release:dry": "release-it --dry-run",
    "db:generate": "yarn workspace @goalos/web db:generate",
    "db:migrate:dev": "yarn workspace @goalos/web db:migrate:dev",
    "db:migrate:deploy": "yarn workspace @goalos/web db:migrate:deploy",
    "db:reset": "yarn workspace @goalos/web db:reset",
    "db:seed": "yarn workspace @goalos/web db:seed",
    "db:studio": "yarn workspace @goalos/web db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@release-it/conventional-changelog": "^10.0.6",
    "husky": "^9.1.7",
    "knip": "^6.1.0",
    "release-it": "^19.2.4",
    "turbo": "^2.5.0",
    "typescript": "^5"
  },
  "packageManager": "yarn@4.9.2"
}
