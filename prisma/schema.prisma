generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Core entities ───────────────────────────────────────────────

enum GoalStatus {
  ACTIVE
  BLOCKED
  WAITING
  COMPLETED
  ARCHIVED
  PAUSED
  ABANDONED
}

model Goal {
  id              String       @id @default(uuid())
  title           String
  description     String?
  targetDate      DateTime?
  successCriteria String?
  status          GoalStatus   @default(ACTIVE)
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  valueId         String?
  value           Value?       @relation("GoalPrimaryValue", fields: [valueId], references: [id], onDelete: SetNull)
  values          Value[]      @relation("GoalValues")

  prerequisites   Prerequisite[]
  actions         Action[]
  vehicleGoals    VehicleGoal[]
  relationshipsFrom Relationship[] @relation("from")
  relationshipsTo   Relationship[] @relation("to")

  @@map("goals")
}

model Stakeholder {
  id                 String   @id @default(uuid())
  name               String
  organization       String?
  role               String?
  relationshipStrength Int     @default(0) // 0-100
  lastInteraction    DateTime?
  notes              String?
  capabilities       Json?    // Array of { capability: string, willingness: string, condition?: string }
  valueExchangeAssets Json?   // Array of { asset: string, category: string, notes?: string }
  userAssets          Json?   // Array of { asset: string, category: string } — what the user can offer
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  values             Value[]    @relation("StakeholderValues")
  evidence           Evidence[]
  relationshipsFrom  Relationship[] @relation("stakeholder_from")
  relationshipsTo    Relationship[] @relation("stakeholder_to")

  @@map("stakeholders")
}

enum PrerequisiteStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

model Prerequisite {
  id              String             @id @default(uuid())
  title           String
  description     String?
  status          PrerequisiteStatus @default(NOT_STARTED)
  confidenceScore Int                @default(0) // 0-100
  goalId          String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  goal            Goal               @relation(fields: [goalId], references: [id], onDelete: Cascade)
  values          Value[]            @relation("PrerequisiteValues")
  evidence        Evidence[]
  relationshipsFrom Relationship[]   @relation("prereq_from")
  relationshipsTo   Relationship[]   @relation("prereq_to")

  @@map("prerequisites")
}

model Evidence {
  id              String   @id @default(uuid())
  title           String
  description     String?
  source          String?  // e.g. "meeting", "email", "document"
  occurredAt      DateTime @default(now())
  prerequisiteId  String?
  stakeholderId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prerequisite    Prerequisite? @relation(fields: [prerequisiteId], references: [id], onDelete: SetNull)
  stakeholder     Stakeholder?  @relation(fields: [stakeholderId], references: [id], onDelete: SetNull)
  values          Value[]       @relation("EvidenceValues")
  relationshipsFrom Relationship[] @relation("evidence_from")
  relationshipsTo   Relationship[] @relation("evidence_to")

  @@map("evidence")
}

enum ActionStatus {
  TODO
  IN_PROGRESS
  DONE
  SKIPPED
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Action {
  id        String         @id @default(uuid())
  title     String
  status    ActionStatus   @default(TODO)
  priority  ActionPriority @default(MEDIUM)
  dueDate   DateTime?
  goalId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  goal      Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  values    Value[]        @relation("ActionValues")
  relationshipsFrom Relationship[] @relation("action_from")
  relationshipsTo   Relationship[] @relation("action_to")

  @@map("actions")
}

// ─── Relationship graph edges ────────────────────────────────────

enum NodeType {
  GOAL
  STAKEHOLDER
  PREREQUISITE
  EVIDENCE
  ACTION
  VEHICLE
}

model Relationship {
  id          String   @id @default(uuid())
  fromType    NodeType
  fromId      String
  toType      NodeType
  toId        String
  label       String?  // describes the relationship
  weight      Float    @default(1.0)
  createdAt   DateTime @default(now())

  // Polymorphic references (nullable, only one pair populated per row)
  goalFrom         Goal?         @relation("from", fields: [goalFromId], references: [id], onDelete: Cascade)
  goalFromId       String?
  goalTo           Goal?         @relation("to", fields: [goalToId], references: [id], onDelete: Cascade)
  goalToId         String?

  stakeholderFrom  Stakeholder?  @relation("stakeholder_from", fields: [stakeholderFromId], references: [id], onDelete: Cascade)
  stakeholderFromId String?
  stakeholderTo    Stakeholder?  @relation("stakeholder_to", fields: [stakeholderToId], references: [id], onDelete: Cascade)
  stakeholderToId  String?

  prereqFrom       Prerequisite? @relation("prereq_from", fields: [prereqFromId], references: [id], onDelete: Cascade)
  prereqFromId     String?
  prereqTo         Prerequisite? @relation("prereq_to", fields: [prereqToId], references: [id], onDelete: Cascade)
  prereqToId       String?

  evidenceFrom     Evidence?     @relation("evidence_from", fields: [evidenceFromId], references: [id], onDelete: Cascade)
  evidenceFromId   String?
  evidenceTo       Evidence?     @relation("evidence_to", fields: [evidenceToId], references: [id], onDelete: Cascade)
  evidenceToId     String?

  actionFrom       Action?       @relation("action_from", fields: [actionFromId], references: [id], onDelete: Cascade)
  actionFromId     String?
  actionTo         Action?       @relation("action_to", fields: [actionToId], references: [id], onDelete: Cascade)
  actionToId       String?

  vehicleFrom      Vehicle?      @relation("vehicle_from", fields: [vehicleFromId], references: [id], onDelete: Cascade)
  vehicleFromId    String?
  vehicleTo        Vehicle?      @relation("vehicle_to", fields: [vehicleToId], references: [id], onDelete: Cascade)
  vehicleToId      String?

  @@unique([fromType, fromId, toType, toId])
  @@map("relationships")
}

// ─── User values ─────────────────────────────────────────────────

model Value {
  id          String   @id @default(uuid())
  label       String   @unique // e.g. "financial security", "health", "relationships"
  rank        Int      @default(0) // higher = more important
  description String?
  tags        String[] // domain tags for matching, e.g. ["money", "career", "wealth"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Primary value FK relations (backward compat)
  goals              Goal[]          @relation("GoalPrimaryValue")
  vehicles           Vehicle[]       @relation("VehiclePrimaryValue")

  // Many-to-many: every entity connects to one or more values
  goalValues         Goal[]          @relation("GoalValues")
  stakeholderValues  Stakeholder[]   @relation("StakeholderValues")
  prerequisiteValues Prerequisite[]  @relation("PrerequisiteValues")
  evidenceValues     Evidence[]      @relation("EvidenceValues")
  actionValues       Action[]        @relation("ActionValues")
  vehicleValues      Vehicle[]       @relation("VehicleValues")
  scheduleEventValues ScheduleEvent[] @relation("ScheduleEventValues")
  opportunityValues  Opportunity[]   @relation("OpportunityValues")

  @@map("values")
}

// ─── Vehicles ────────────────────────────────────────────────────

enum VehicleStatus {
  IDENTIFIED    // Spotted as a potential vehicle
  RESEARCHING   // Actively evaluating feasibility/fit
  ACQUIRING     // In the process of obtaining (applying, purchasing, joining)
  BUILDING      // Acquired but still setting up / not yet generating value
  ACTIVE        // Operational and producing leverage
  DORMANT       // Exists but not currently leveraged
  RETIRED       // No longer providing value
}

enum VehicleType {
  EDUCATION      // Degrees, certifications, courses
  EMPLOYMENT     // Jobs, positions, roles
  BUSINESS       // Companies, freelance, side projects
  ASSET          // Real estate, investments, IP, physical vehicles (cars etc.)
  PLATFORM       // Blog, podcast, social media, open source project
  NETWORK        // Alumni groups, professional associations
  ORGANIZATION   // Religious institutions, political parties, clubs, fraternities
  EVENT_SERIES   // Hosted dinners, meetups, salons, parties
  SKILL          // Deep expertise that compounds
  OTHER
}

model Vehicle {
  id              String         @id @default(uuid())
  title           String
  description     String?
  type            VehicleType
  status          VehicleStatus  @default(IDENTIFIED)
  institution     String?        // e.g. "MIT", "Stripe", "Y Combinator"
  startDate       DateTime?
  endDate         DateTime?      // null = ongoing
  investmentNotes String?        // what it costs (time, money, effort)
  leverageScore   Int            @default(0) // computed: linked goals × priority
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  valueId         String?
  value           Value?         @relation("VehiclePrimaryValue", fields: [valueId], references: [id], onDelete: SetNull)
  values          Value[]        @relation("VehicleValues")

  vehicleGoals    VehicleGoal[]
  opportunities   Opportunity[]
  controlDimensions ControlDimension[]
  relationshipsFrom Relationship[] @relation("vehicle_from")
  relationshipsTo   Relationship[] @relation("vehicle_to")

  @@map("vehicles")
}

model VehicleGoal {
  id          String   @id @default(uuid())
  vehicleId   String
  goalId      String
  leverage    String?  // how the vehicle helps: "Provides faculty recommendations"
  createdAt   DateTime @default(now())

  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, goalId])
  @@map("vehicle_goals")
}

model Opportunity {
  id          String    @id @default(uuid())
  title       String
  description String?
  vehicleId   String
  goalId      String?   // optionally links to a goal it benefits
  realized    Boolean   @default(false)
  realizedAt  DateTime?
  createdAt   DateTime  @default(now())

  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  values      Value[]   @relation("OpportunityValues")

  @@map("opportunities")
}

// ─── Calendar & Schedule ─────────────────────────────────────────

enum CalendarProvider {
  GOOGLE
  MICROSOFT
}

model CalendarConnection {
  id            String           @id @default(uuid())
  provider      CalendarProvider
  accountEmail  String
  accessToken   String
  refreshToken  String?
  tokenExpiry   DateTime?
  calendarId    String?          // specific calendar to sync (null = primary)
  syncEnabled   Boolean          @default(true)
  lastSyncAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  scheduleEvents ScheduleEvent[]

  @@unique([provider, accountEmail])
  @@map("calendar_connections")
}

enum ScheduleEventSource {
  GOALOS       // created in GoalOS
  GOOGLE       // synced from Google Calendar
  MICROSOFT    // synced from Microsoft Calendar
}

model ScheduleEvent {
  id                   String              @id @default(uuid())
  title                String
  description          String?
  startTime            DateTime
  endTime              DateTime
  allDay               Boolean             @default(false)
  location             String?
  source               ScheduleEventSource @default(GOALOS)
  externalId           String?             // id in the external calendar
  externalCalendarId   String?
  goalId               String?             // linked GoalOS goal
  actionId             String?             // linked GoalOS action
  calendarConnectionId String?
  color                String?             // hex color for display
  recurrence           String?             // none | daily | weekly | monthly | yearly
  recurrenceGroupId    String?             // shared id linking recurring instances
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  calendarConnection   CalendarConnection? @relation(fields: [calendarConnectionId], references: [id], onDelete: SetNull)
  values               Value[]             @relation("ScheduleEventValues")

  @@index([startTime, endTime])
  @@index([goalId])
  @@index([actionId])
  @@index([externalId])
  @@index([recurrenceGroupId])
  @@map("schedule_events")
}

// ─── Resource flow engine ─────────────────────────────────────────

enum FlowDirection {
  INFLOW
  OUTFLOW
}

enum FlowFrequency {
  ONE_TIME
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model ResourceType {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "Financial", "Emotional Energy", "Social Capital"
  unit        String   // e.g. "USD", "points", "hours", "connections"
  icon        String?  // emoji or icon identifier
  color       String?  // hex color for charts
  description String?
  isDefault   Boolean  @default(false) // system-provided types
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  flows       ResourceFlow[]

  @@map("resource_types")
}

model ResourceFlow {
  id              String        @id @default(uuid())
  resourceTypeId  String
  entityType      NodeType      // GOAL, VEHICLE, STAKEHOLDER, etc.
  entityId        String
  direction       FlowDirection
  amount          Float
  frequency       FlowFrequency @default(ONE_TIME)
  label           String        // user-defined description: "Monthly salary", "Emotional drain from conflict"
  notes           String?
  startDate       DateTime?     // when this flow begins (null = already active)
  endDate         DateTime?     // when this flow ends (null = ongoing)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  resourceType    ResourceType  @relation(fields: [resourceTypeId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([resourceTypeId])
  @@index([direction])
  @@map("resource_flows")
}

// ─── Vehicle control dimensions ──────────────────────────────────

model ControlDimension {
  id          String   @id @default(uuid())
  vehicleId   String
  name        String   // e.g. "Financial Access", "Army Control", "Population Sentiment"
  description String?
  value       Float    @default(0) // 0-100 scale
  icon        String?  // emoji
  color       String?  // hex
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, name])
  @@map("control_dimensions")
}

// ─── Event sourcing ──────────────────────────────────────────────

model Event {
  id          String   @id @default(uuid())
  entityType  NodeType
  entityId    String
  eventType   String   // e.g. "CREATED", "UPDATED", "STATUS_CHANGED", "RELATIONSHIP_ADDED"
  payload     Json
  occurredAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@map("events")
}
