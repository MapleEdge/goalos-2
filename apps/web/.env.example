DATABASE_URL="postgresql://goalos:goalos_dev@localhost:5432/goalos?schema=public"

# ── Authentication (Auth.js / NextAuth v5) ──
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-secret
AUTH_TRUST_HOST=true
# Optional Google OAuth (leave unset to use email/password only)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI config (optional - the reasoning engine, intent parsing, and goal
# suggestions all fall back to non-AI behavior when no key is set).
# Powered by Google Gemini via the @google/genai SDK.
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# ── Commercial billing (server-authoritative tiers: Free / Pro / Max) ──
# Required in production. AI access, tier, and credits are resolved
# server-side from the subscription token the client sends. Keys never
# reach the client.

# Encryption key for per-customer Gemini keys stored at rest (AES-256-GCM).
# Use a long random string, e.g. `openssl rand -base64 48`.
# APP_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# Public base URL of this app — used to build Stripe redirect URLs.
# APP_BASE_URL=http://localhost:3000

# Stripe (test mode keys start with sk_test_ / whsec_).
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_PRO_ID=price_xxx
# STRIPE_PRICE_MAX_ID=price_xxx

# Google Cloud API Keys API — mints a restricted Gemini key per paid customer.
# Service account needs apikeys.keys.create / .delete on the project.
# Leave unset to have paid tiers fall back to the shared GEMINI_API_KEY.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
